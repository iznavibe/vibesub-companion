{
  "$schema": "https://schema.tauri.app/capabilities/1",
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:default",
    "shell:default",
    "shell:allow-open",
    "store:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://huggingface.co/**" },
        { "url": "https://api.anthropic.com/**" },
        { "url": "https://api.openai.com/**" },
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1:*/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/**", "$DOWNLOAD/**", "$HOME/**", "$VIDEO/**", "$DESKTOP/**"]
    }
  ]
}
